{
	"name": "nextjs-template",
	"version": "1.0.0",
	"description": "A template for Next.js projects",
	"rootDir": "src",
	"type": "module",
	"scripts": {
		"test": "mocha tests/**/*.ts",
		"lint": "eslint src",
		"lint:fix": "eslint --fix src",
		"prettier": "prettier .",
		"prettier:fix": "prettier --write .",
		"prebuild": "yarn typegen",
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"coverage": "nyc npm run test",
		"analyze": "cross-env ANALYZE=true next build",
		"typegen": "sanity schema extract --path=src/sanity/extract.json --enforce-required-fields && sanity typegen generate && rimraf src/sanity/extract.json && yarn lint:fix"
	},
	"pre-commit": [
		"lint:fix",
		"prettier:fix",
		"build",
		"test",
		"coverage"
	],
	"mocha": {
		"node-option": [
			"import=tsx"
		]
	},
	"keywords": [],
	"author": "FallenDeity",
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^1.2.6",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.20.0",
		"@next/bundle-analyzer": "^15.2.0",
		"@next/eslint-plugin-next": "^15.1.6",
		"@tailwindcss/postcss": "^4.0.5",
		"@tailwindcss/typography": "^0.5.16",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.1",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/eslint-plugin": "^8.23.0",
		"@typescript-eslint/parser": "^8.23.0",
		"autoprefixer": "^10.4.20",
		"cross-env": "^7.0.3",
		"eslint": "9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^15.14.0",
		"mdx-mermaid": "^2.0.3",
		"mocha": "^11.1.0",
		"nyc": "^17.1.0",
		"pino-pretty": "^13.0.0",
		"postcss": "^8.5.1",
		"pre-commit": "^1.2.2",
		"prettier": "^3.4.2",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-color-chips": "^0.1.3",
		"rehype-katex": "^7.0.1",
		"rehype-pretty-code": "^0.14.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-deflist": "^1.0.0",
		"remark-emoji": "^5.0.1",
		"remark-math": "^6.0.0",
		"remark-stringify": "^11.0.0",
		"remark-toc": "^9.0.0",
		"rimraf": "^6.0.1",
		"shiki": "^3.2.1",
		"tailwindcss": "^4.0.5",
		"ts-loader": "^9.5.2",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"webpack": "^5.97.1",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@neondatabase/serverless": "^0.10.4",
		"@radix-ui/react-avatar": "^1.1.3",
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-collapsible": "^1.1.3",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-progress": "^1.1.2",
		"@radix-ui/react-separator": "^1.1.2",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@sanity/asset-utils": "^2.2.1",
		"@sanity/icons": "^3.6.0",
		"@sanity/image-url": "1",
		"@sanity/vision": "3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "1.0.0",
		"colorthief": "^2.6.0",
		"date-fns": "^4.1.0",
		"easymde": "2",
		"framer-motion": "^12.4.3",
		"keen-slider": "^6.8.6",
		"lucide-react": "^0.475.0",
		"mermaid": "^11.5.0",
		"mini-svg-data-uri": "^1.4.4",
		"motion": "^12.4.2",
		"next": "^15.1.6",
		"next-mdx-remote": "^5.0.0",
		"next-sanity": "^9.8.59",
		"next-themes": "^0.4.6",
		"pino": "^9.6.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"remark-gfm": "^4.0.1",
		"sanity": "3",
		"sanity-plugin-markdown": "^5.0.0",
		"simplex-noise": "^4.0.3",
		"sonner": "^2.0.1",
		"styled-components": "6",
		"tailwind-merge": "^3.0.1",
		"tailwind-scrollbar": "^4.0.0",
		"tailwind-scrollbar-hide": "^2.0.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"printWidth": 120,
		"bracketSpacing": true,
		"bracketSameLine": true,
		"endOfLine": "auto",
		"plugins": [
			"prettier-plugin-tailwindcss"
		]
	},
	"repository": "https://github.com/FallenDeity/react-next-tailwind-template"
}
